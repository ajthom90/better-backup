<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>better-backup-server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/bb-server</string>
		<string>serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Library/Logs/better-backup-server.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/better-backup-server.log</string>
</dict>
</plist>
