[Unit]
Description=better-backup server
Documentation=https://github.com/ajthom90/better-backup
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/bb-server serve
Environment=BB_DATA=/var/lib/better-backup
EnvironmentFile=-/etc/default/better-backup-server
Restart=always
RestartSec=5
StateDirectory=better-backup
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
